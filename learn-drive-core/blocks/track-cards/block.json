{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "learn-drive/track-cards",
	"title": "Programmes phares",
	"category": "learn-drive",
	"icon": "awards",
	"description": "Cartes des catégories (permis, matières) avec les règles de l’examen, le nombre de leçons et de quiz, et un accès direct à l’examen blanc. Mode « examens » : choix de l’examen blanc à passer.",
	"textdomain": "learn-drive-core",
	"attributes": {
		"country": {
			"type": "string",
			"default": ""
		},
		"layout": {
			"type": "string",
			"enum": [
				"grid",
				"carousel"
			],
			"default": "grid"
		},
		"count": {
			"type": "integer",
			"default": 8
		},
		"mode": {
			"type": "string",
			"enum": [
				"all",
				"exams"
			],
			"default": "all"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "learn-drive-core-editor",
	"style": "learn-drive-core-blocks",
	"render": "file:./render.php"
}
