{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "learn-drive/question-of-the-day",
	"title": "Question du jour",
	"category": "learn-drive",
	"icon": "calendar-alt",
	"description": "Une question jouable directement, renouvelée chaque jour.",
	"textdomain": "learn-drive-core",
	"attributes": {
		"track": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"spacing": {
			"margin": true
		},
		"interactivity": true
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"editorScript": "learn-drive-core-editor",
	"style": "learn-drive-core-quiz",
	"render": "file:./render.php",
	"viewScriptModule": "learn-drive-quiz"
}