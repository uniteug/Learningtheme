				},
				{
					"name": "Monospace",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			]
		},
		"custom": {
			"radius": {
				"card": "8px",
				"control": "8px"
			},
			"line-height": {
				"tight": "1.15",
				"heading": "1.25",
				"body": "1.65"
			},
			"tap-target": "48px",
			"on-accent": "#111827",
			"dark": {
				"base": "#0B1220",
				"surface": "#131C2E",
				"contrast": "#E8EDF5",
				"muted": "#A3B0C4",
				"border": "#28354C",
				"primary": "#7EA3FF",
				"secondary": "#C3CEDF",
				"accent": "#FFC531",
				"success": "#4ADE80",
				"error": "#F87171",
				"warning": "#FBBF24",
				"on-accent": "#111827",
				"premium": "#B794F6"
			}
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			},
			"core/pullquote": {
				"border": { "color": true, "radius": true, "style": true, "width": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--atkinson)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "var(--wp--custom--line-height--body)",
			"fontStyle": "normal",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "none" }
				},
				":focus": {
					"typography": { "textDecoration": "none" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--atkinson)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
			},
			"h5": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "textTransform": "uppercase", "letterSpacing": "0.04em" }
			},
			"h6": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--control)",
					"width": "0",
					"style": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.35rem",
						"right": "1.35rem"
					}
				},
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--primary) 85%, #000)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--primary) 85%, #000)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"cite": {
				"typography": { "fontStyle": "normal", "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "700" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)", "fontWeight": "700", "textTransform": "uppercase", "letterSpacing": "0.05em" },
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/post-excerpt": {
				"color": { "text": "var(--wp--preset--color--muted)" }
			},
			"core/post-author-name": {
				"typography": { "fontWeight": "700" }
			},
			"core/breadcrumbs": {
				"color": { "text": "var(--wp--preset--color--muted)" },
