{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Route claire",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "base", "name": "Fond", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Surface", "color": "#F3F6FB" },
				{ "slug": "contrast", "name": "Texte", "color": "#0F172A" },
				{ "slug": "muted", "name": "Texte discret", "color": "#475569" },
				{ "slug": "border", "name": "Bordure", "color": "#D5DDE8" },
				{ "slug": "primary", "name": "Primaire", "color": "#1F4FD8" },
				{ "slug": "secondary", "name": "Secondaire", "color": "#334155" },
				{ "slug": "accent", "name": "Accent", "color": "#FFC531" },
				{ "slug": "success", "name": "Réussite", "color": "#15803D" },
				{ "slug": "error", "name": "Erreur", "color": "#DC2626" },
				{ "slug": "warning", "name": "Avertissement", "color": "#B45309" },
				{ "slug": "premium", "name": "Premium", "color": "#7C3AED" }
			],
			"gradients": [
				{
					"slug": "hero",
					"name": "Bandeau",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, color-mix(in srgb, var(--wp--preset--color--primary) 70%, #000) 100%)"
				},
				{
					"slug": "surface-fade",
					"name": "Surface dégradée",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--surface) 0%, var(--wp--preset--color--base) 100%)"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "2XS", "size": "0.375rem" },
				{ "slug": "20", "name": "XS", "size": "0.625rem" },
				{ "slug": "30", "name": "S", "size": "clamp(0.875rem, 0.8rem + 0.3vw, 1rem)" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 1.5rem + 1vw, 2.25rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.25rem, 1.8rem + 2vw, 3.5rem)" },
				{ "slug": "70", "name": "2XL", "size": "clamp(3rem, 2.2rem + 3.5vw, 5rem)" },
				{ "slug": "80", "name": "3XL", "size": "clamp(4rem, 3rem + 5vw, 7rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Douce", "shadow": "0 1px 2px rgb(15 23 42 / 0.06), 0 1px 3px rgb(15 23 42 / 0.08)" },
				{ "slug": "raised", "name": "Relief", "shadow": "0 6px 24px -6px rgb(15 23 42 / 0.18)" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"radiusSizes": [
				{ "slug": "small", "name": "Petit", "size": "6px" },
				{ "slug": "medium", "name": "Moyen", "size": "8px" },
				{ "slug": "large", "name": "Grand", "size": "14px" },
				{ "slug": "pill", "name": "Pilule", "size": "999px" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"writingMode": false,
			"fontSizes": [
				{ "slug": "x-small", "name": "Très petite", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Petite", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Moyenne", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Grande", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Très grande", "size": "1.875rem", "fluid": { "min": "1.5rem", "max": "2.125rem" } },
				{ "slug": "xx-large", "name": "Énorme", "size": "2.625rem", "fluid": { "min": "2rem", "max": "3.125rem" } },
				{ "slug": "huge", "name": "Gigantesque", "size": "3.5rem", "fluid": { "min": "2.375rem", "max": "4.25rem" } }
			],
			"fontFamilies": [
				{
					"name": "Atkinson Hyperlegible",
					"slug": "atkinson",
					"fontFamily": "\"Atkinson Hyperlegible\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
